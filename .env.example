# PostgreSQL connection string. See README.md for local dev (npx prisma dev)
# and production (Prisma Postgres via `npx create-db`, or Neon/Supabase/etc.) setup.
DATABASE_URL="postgres://postgres:postgres@localhost:<port>/template1?sslmode=disable"

# Password gate for the Database Obligasi page (view/add/edit/delete).
# DB_AUTH_SECRET: random key, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# DB_ACCESS_PASSWORD_HASH: HMAC-SHA256(DB_AUTH_SECRET, your-password), hex-encoded --
#   e.g. `node -e "console.log(require('crypto').createHmac('sha256', process.env.SECRET).update('your-password').digest('hex'))" SECRET=<DB_AUTH_SECRET>`.
DB_AUTH_SECRET=""
DB_ACCESS_PASSWORD_HASH=""
